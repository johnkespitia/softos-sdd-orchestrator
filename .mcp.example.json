{
  "mcpServers": {
    "engram": {
      "command": "engram",
      "args": [
        "mcp"
      ],
      "env": {
        "ENGRAM_PROJECT": "plg-platform-harness",
        "ENGRAM_DATA_DIR": "/workspace/.flow/memory/engram"
      }
    },
    "graphify": {
      "command": "graphify-mcp",
      "args": [
        "/workspace/graphify-out/graph.json"
      ]
    },
    "graphify-hub-frontend": {
      "command": "graphify-mcp",
      "args": [
        "/workspace/hub-frontend/graphify-out/graph.json"
      ]
    },
    "graphify-dashboard-frontend": {
      "command": "graphify-mcp",
      "args": [
        "/workspace/dashboard-frontend/graphify-out/graph.json"
      ]
    },
    "graphify-plg-platform-backend": {
      "command": "graphify-mcp",
      "args": [
        "/workspace/plg-platform-backend/graphify-out/graph.json"
      ]
    }
  }
}
