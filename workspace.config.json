{
  "project": {
    "display_name": "PLG Platform Harness",
    "root_repo": "plg-platform-harness"
  },
  "repos": {
    "plg-platform-harness": {
      "path": ".",
      "kind": "root",
      "slice_prefix": "root",
      "compose_service": "workspace",
      "target_roots": [
        ".gitignore",
        "AGENTS.md",
        "CURSOR.md",
        "OPENCODE.md",
        "opencode.json",
        "README.md",
        "TODO.md",
        ".agents",
        ".cursor",
        ".devcontainer",
        ".mcp.example.json",
        ".flow/memory",
        "gateway",
        "flow",
        "templates",
        "specs",
        "docs",
        ".tessl",
        ".github",
        "scripts",
        "flowctl",
        "capabilities",
        "runtimes",
        "workspace.capabilities.json",
        "workspace.config.json",
        "workspace.preflight.json",
        "workspace.providers.json",
        "workspace.runtimes.json",
        "workspace.secrets.json",
        "workspace.skills.json",
        "workspace.stack.json",
        "tessl.json",
        "Makefile",
        "policies",
        "profiles"
      ],
      "default_targets": [
        "../../specs/**/*.spec.md",
        "../../docs/**/*.md",
        "../../flow",
        "../../workspace.config.json",
        "../../workspace.stack.json",
        "../../policies/**/*.md",
        "../../profiles/**/*.md",
        "../../profiles/**/*.json"
      ],
      "runtime": "python"
    },
    "plg-platform-backend": {
      "path": "plg-platform-backend",
      "compose_service": "web-server",
      "compose_file": "plg-platform-backend/docker-compose.yaml",
      "kind": "implementation",
      "runtime": "php-laravel8-apache",
      "capabilities": [
        "laravel8"
      ],
      "repo_strategy": "submodule",
      "slice_prefix": "plg-platform-backend",
      "default_targets": [
        "../../plg-platform-backend/src/**"
      ],
      "target_roots": [
        ".github",
        "AGENTS.md",
        "Makefile",
        "docker-compose.yaml",
        "php.Dockerfile",
        ".env.example",
        "config",
        "src",
        "src/tests"
      ],
      "contract_roots": [
        ".github",
        "AGENTS.md",
        "Makefile",
        "docker-compose.yaml",
        "php.Dockerfile",
        ".env.example",
        "config",
        "src",
        "src/tests"
      ],
      "test_required_roots": [
        "src"
      ],
      "agent_skill_refs": [
        "workspace/softos-spec-definition-playbook",
        "workspace/softos-reference-spec-hardening",
        "workspace/softos-schema-hardening-gates",
        "workspace/softos-staging-promote-preflight",
        "workspace/softos-worktree-hygiene",
        "workspace/spec-driven-workspace",
        "workspace/php-core",
        "workspace/laravel-8"
      ],
      "test_runner": "php",
      "test_hint": "../../plg-platform-backend/src/tests",
      "ci": {
        "mode": "workflow-dispatch",
        "workflow": "repo-ci.yml",
        "workflow_repository": "PLGEducation/plg-platform-backend",
        "trigger_mode": "workflow_dispatch_only",
        "install": [
          "composer",
          "--working-dir=src",
          "install",
          "--no-interaction",
          "--prefer-dist"
        ],
        "test": [
          "php",
          "-d",
          "memory_limit=512M",
          "src/vendor/bin/phpunit",
          "-c",
          "src/phpunit.xml"
        ]
      }
    }
  },
  "memory": {
    "agent": {
      "provider": "engram",
      "project": "plg-platform-harness",
      "data_dir": ".flow/memory/engram",
      "source_boundary": "consultive"
    },
    "execution": {
      "recall_before_plan": false,
      "save_after_release_publish": false
    }
  },
  "code_graph": {
    "provider": "graphify",
    "version": "0.9.56",
    "output_dir": "graphify-out",
    "mode": "code-only",
    "source_boundary": "derived"
  },
  "examples": {
    "project_release_deploy": {
      "legacy-api": {
        "deploy": {
          "provider": "github-actions",
          "providers_by_env": {
            "staging": "github-actions",
            "production": "github-actions"
          },
          "promotion_strategy": {
            "mode": "pull_request"
          },
          "contract": {
            "deploy_requires_pr": true,
            "deploy_requires_healthcheck": true,
            "post_deploy_smoke_required": true
          },
          "verify": {
            "mode": "healthcheck",
            "retry": {
              "attempts": 4,
              "backoff_seconds": 5
            }
          },
          "env": {
            "FLOW_DEPLOY_GITHUB_REPO": "acme/legacy-api",
            "FLOW_DEPLOY_GITHUB_WORKFLOW": "promotion-pr.yml",
            "FLOW_DEPLOY_GITHUB_REF": "main"
          },
          "env_by_env": {
            "staging": {
              "FLOW_DEPLOY_SOURCE_REF": "release",
              "FLOW_DEPLOY_RUN_MIGRATIONS": "true"
            },
            "production": {
              "FLOW_DEPLOY_SOURCE_REF": "staging"
            }
          }
        },
        "ci": {
          "install_contract": {
            "mode": "strict",
            "manifest_files": [
              "package.json"
            ],
            "lock_files": [
              "pnpm-lock.yaml"
            ]
          }
        }
      }
    }
  },
  "agents": {
    "schema_version": 1,
    "executors": {
      "codex": {
        "adapter": "codex",
        "executable": "codex",
        "argv": []
      },
      "cursor": {
        "adapter": "cursor",
        "executable": "agent",
        "argv": []
      },
      "opencode": {
        "adapter": "opencode",
        "executable": "opencode",
        "argv": []
      },
      "opencode-local": {
        "adapter": "opencode",
        "executable": "opencode-softos",
        "argv": []
      }
    }
  },
  "agent_resources": {
    "schema_version": 1,
    "resources": {
      "opencode-local": {
        "executor": "opencode-local",
        "capabilities": [
          "tool_calling",
          "write",
          "local_execution"
        ],
        "capacity": 1,
        "cost_tier": "local",
        "selection_priority": 10,
        "model_resolution": "worker_profile",
        "data_sensitivity": "local-only"
      },
      "opencode-free": {
        "executor": "opencode",
        "capabilities": [
          "tool_calling",
          "write",
          "cloud_execution"
        ],
        "capacity": 1,
        "cost_tier": "cloud/free",
        "selection_priority": 20,
        "model_resolution": "dynamic_free",
        "data_sensitivity": "cloud-eligible",
        "candidate_tie_break": "lexical"
      },
      "opencode-go": {
        "executor": "opencode",
        "capabilities": [
          "tool_calling",
          "write",
          "cloud_execution",
          "architecture"
        ],
        "capacity": 1,
        "cost_tier": "cloud/paid-low",
        "selection_priority": 30,
        "model_resolution": "dynamic_go",
        "data_sensitivity": "cloud-eligible",
        "candidate_tie_break": "lexical"
      }
    }
  }
}
